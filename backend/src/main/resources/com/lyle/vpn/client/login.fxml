<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.lyle.vpn.client.LoginController">
    <center>
        <VBox spacing="14" alignment="CENTER">
            <padding><Insets top="35" right="45" bottom="35" left="45"/></padding>

            <Label text="🔒 Office VPN" styleClass="title"/>
            <Label text="Secure Office Network Simulator" styleClass="subtitle"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Server" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="hostField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Port" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="portField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Username" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="usernameField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Password" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <PasswordField fx:id="passwordField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <Button text="Connect" onAction="#connect" defaultButton="true" maxWidth="180"/>
            <Label fx:id="statusLabel" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
