<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.lyle.vpn.client.DashboardController">
    <top>
        <HBox spacing="18" alignment="CENTER_LEFT" styleClass="topbar">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="🔒 Office VPN" styleClass="header"/>
            <Label fx:id="identityLabel"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel"/>
            <Button text="Disconnect" onAction="#disconnect"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabs">
            <Tab text="Secure Messages" closable="false">
                <VBox spacing="10">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <TextArea fx:id="messagesArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="8">
                        <TextField fx:id="messageField" promptText="Enter an encrypted message..." HBox.hgrow="ALWAYS"
                                   onAction="#sendMessage"/>
                        <Button text="Send" onAction="#sendMessage"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="Admin" closable="false">
                <VBox spacing="12">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <HBox spacing="8">
                        <TextField fx:id="newUsernameField" promptText="Username"/>
                        <PasswordField fx:id="newPasswordField" promptText="Temporary password"/>
                        <ComboBox fx:id="newRoleBox"/>
                        <Button text="Create user" onAction="#createUser"/>
                    </HBox>

                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="userColumn" text="Username" prefWidth="220"/>
                            <TableColumn fx:id="roleColumn" text="Role" prefWidth="150"/>
                            <TableColumn fx:id="enabledColumn" text="Enabled" prefWidth="120"/>
                        </columns>
                    </TableView>

                    <HBox spacing="8">
                        <Button text="Refresh users" onAction="#refreshUsers"/>
                        <Button text="Enable selected" onAction="#enableSelected"/>
                        <Button text="Disable selected" onAction="#disableSelected"/>
                        <Button text="Refresh logs" onAction="#refreshLogs"/>
                    </HBox>

                    <Label text="Recent connection logs" styleClass="section-title"/>
                    <TextArea fx:id="logsArea" editable="false" prefRowCount="8" wrapText="false"/>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
